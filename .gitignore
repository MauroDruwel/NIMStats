# .gitignore for NIM Benchmarking Dashboard

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
.vscode/

# Node (if you add npm packages later)
node_modules/
package-lock.json
yarn.lock

# IDE
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Legacy JSON history (replaced by history.db)
history.json

# Temporary benchmark output files
scripts/results*.json

# Python
__pycache__/
*.pyc

# SQLite database (despawned in favor of Cloudflare D1)
history.db
*.db
*.db-journal
*.db-wal

# Cloudflare D1 exports
scripts/d1_seed.sql
scripts/d1_backfill.sql
.dev.vars
.dev.vars.*
.wrangler/

